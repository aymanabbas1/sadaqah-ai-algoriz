APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8001
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Configure Groq. Never expose this value to the frontend.
LLM_PROVIDER=groq
LLM_MODEL=
OPENAI_API_KEY=
GROQ_API_KEY=

# Copy the Data API URL and a backend-only secret key from Supabase.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
DATA_REPOSITORY=supabase
